# context-lab runner configuration. Copy to .env and edit; context_lab.py
# loads .env itself (a shell-exported variable still wins). Never commit .env.

# Default runner: ollama | endpoint | cli
BENCH_RUNNER=ollama

# --- ollama runner (default) ---
# Start Ollama and pull the model before class:  ollama pull qwen2.5:3b
BENCH_MODEL=qwen2.5:3b

# --- endpoint runner: any OpenAI-compatible /chat/completions service ---
# This cohort's named hosted option is OpenRouter. Pass --model <slug> on the
# command with a current :free-tagged model (never openrouter/free, its
# auto-router picks inconsistently); pick one at openrouter.ai/models.
# BENCH_API_BASE=https://openrouter.ai/api/v1
# BENCH_API_KEY=<your-api-key>

# --- cli runner: a local headless agent CLI ---
# This cohort's named capable-agent CLI, Antigravity's `agy -p`, headless/print
# mode, is the built-in default: BENCH_RUNNER=cli needs nothing else. Run
# `agy` once interactively first, to authenticate. Set BENCH_CMD only to use a
# different CLI:
# BENCH_CMD=sh -c "<cli> <print-flag> \"$(cat \"$1\")\"" -- {context_file}
# A stdin CLI instead:  BENCH_CMD=<cli> <flags>

# --- optional mem0 instructor demo (never on the graded path) ---
# ollama pull nomic-embed-text
# uv run --with-requirements requirements-mem0.txt python3 context_lab.py <scenario> --memory-backend mem0
# MEM_LLM=qwen2.5:3b
# MEM_EMBEDDER=nomic-embed-text
# MEM_STORE=~/.context-lab-mem0
